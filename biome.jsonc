{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true,
    },
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": "error",
      },
      "suspicious": {
        "noDebugger": "error",
      },
    },
  },
  "formatter": {
    "enabled": false,
  },
  "assist": {
    "enabled": false,
  },
}
