NODE_ENV=development
DATABASE_URL=
POSTGRES_DB=magina
POSTGRES_USER=postgres
POSTGRES_PORT=5433
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false
VITE_API_URL=http://localhost:3000
# Solo para el contenedor local de desarrollo. En producciÃ³n usa un secreto de gestor de secretos.
POSTGRES_PASSWORD=
# Usa un valor aleatorio nuevo por ambiente, mÃ­nimo 32 caracteres.
AUTENTICACION_SECRETO=
AUTENTICACION_DURACION_SEGUNDOS=28800
AUTENTICACION_DURACION_RECORDAR_SEGUNDOS=2592000
UPLOADS_DIR=storage
IMAGEN_MAXIMO_BYTES=5242880

# NubeFact API (credenciales solo en el servidor)
NUBEFACT_AMBIENTE=DEMO
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

NUBEFACT_SERIE_BOLETA=
NUBEFACT_SERIE_FACTURA=
NUBEFACT_SERIE_GUIA_REMITENTE=
NUBEFACT_SERIE_GUIA_TRANSPORTISTA=
