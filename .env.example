NODE_ENV=development
DATABASE_URL=
POSTGRES_DB=magina
POSTGRES_USER=postgres
POSTGRES_PORT=5433
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false
VITE_API_URL=http://localhost:3000
# Solo para el contenedor local de desarrollo. En producciÃ³n usa un secreto de gestor de secretos.
POSTGRES_PASSWORD=
# Usa un valor aleatorio nuevo por ambiente, mÃ­nimo 32 caracteres.
AUTENTICACION_SECRETO=
AUTENTICACION_DURACION_SEGUNDOS=28800
AUTENTICACION_DURACION_RECORDAR_SEGUNDOS=2592000

# SUNAT SIRE Compras (API de solo lectura para importar/consultar propuestas RCE)
# Crear las credenciales de API desde SUNAT Operaciones en Línea y no compartirlas por chat.
SUNAT_SIRE_RUC=
SUNAT_SIRE_USUARIO_SOL=
SUNAT_SIRE_CLAVE_SOL=
SUNAT_SIRE_CLIENT_ID=
SUNAT_SIRE_CLIENT_SECRET=
UPLOADS_DIR=storage
IMAGEN_MAXIMO_BYTES=5242880

# NubeFact API: la ruta y el token indican la cuenta que procesa las emisiones (solo servidor)
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

REGIMEN_TRIBUTARIO=RER
NUBEFACT_TIMEOUT_MS=20000
DESCUENTO_MAXIMO_PORCENTAJE=0

# APIS PerÃº: token para consultar dniruc.apisperu.com (solo servidor)
APIS_PERU_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/integraciones/google-drive/oauth/callback
# ID de “Bóveda de información - Inversiones Maguiña” (no la raíz de Mi unidad).
GOOGLE_DRIVE_VAULT_FOLDER_ID=
# Se cifra localmente el token OAuth renovable; usa una clave aleatoria de 32 bytes en base64.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_TOKEN_FILE=storage/google-drive-token.enc
