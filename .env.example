# APIS PerÃº: token para consultar dniruc.apisperu.com (solo servidor)
APIS_PERU_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/integraciones/google-drive/oauth/callback
# ID de “Bóveda de información - Inversiones Maguiña” (no la raíz de Mi unidad).
GOOGLE_DRIVE_VAULT_FOLDER_ID=
# Se cifra localmente el token OAuth renovable; usa una clave aleatoria de 32 bytes en base64.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_TOKEN_FILE=storage/google-drive-token.enc
