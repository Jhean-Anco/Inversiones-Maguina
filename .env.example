NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/magina
POSTGRES_DB=magina
POSTGRES_USER=postgres
POSTGRES_PORT=5433
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false
VITE_API_URL=http://localhost:3000
# Solo para el contenedor local de desarrollo. En producción usa un secreto de gestor de secretos.
POSTGRES_PASSWORD=postgres
# Usa un valor aleatorio nuevo por ambiente, mínimo 32 caracteres.
AUTENTICACION_SECRETO=generar-un-secreto-aleatorio-de-al-menos-32-bytes
AUTENTICACION_DURACION_SEGUNDOS=28800
AUTENTICACION_DURACION_RECORDAR_SEGUNDOS=2592000
UPLOADS_DIR=storage
IMAGEN_MAXIMO_BYTES=5242880

# NubeFact API (credenciales solo en el servidor)
NUBEFACT_AMBIENTE=DEMO
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

NUBEFACT_SERIE_BOLETA=
NUBEFACT_TIMEOUT_MS=20000
DESCUENTO_MAXIMO_PORCENTAJE=0

# APIS Perú: token para consultar dniruc.apisperu.com (solo servidor)
APIS_PERU_TOKEN=
