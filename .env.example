NODE_ENV=development
DATABASE_URL=
POSTGRES_DB=magina
POSTGRES_USER=postgres
POSTGRES_PORT=5433
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false
VITE_API_URL=http://localhost:3000
# Solo para el contenedor local de desarrollo. En producciÃ³n usa un secreto de gestor de secretos.
POSTGRES_PASSWORD=
# Usa un valor aleatorio nuevo por ambiente, mÃ­nimo 32 caracteres.
AUTENTICACION_SECRETO=
AUTENTICACION_DURACION_SEGUNDOS=28800
AUTENTICACION_DURACION_RECORDAR_SEGUNDOS=2592000

UPLOADS_DIR=storage

# NubeFact API: la ruta y el token indican la cuenta que procesa las emisiones (solo servidor).
# Series y correlativos se administran en Configuración > Series, en la base de datos.
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# Datos del emisor impresos en tickets y A4 (opcionales; se usan si no hay datos guardados en la base).
# Si defines alguno de RUC, razón social o dirección, define los tres.
EMPRESA_RUC=
EMPRESA_RAZON_SOCIAL=
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=
EMPRESA_MENSAJE_PIE=

REGIMEN_TRIBUTARIO=RER
NUBEFACT_TIMEOUT_MS=20000
# Seguimiento automático de documentos pendientes en NubeFact/SUNAT (opcional; valores predeterminados).
NUBEFACT_SEGUIMIENTO_ACTIVO=true
NUBEFACT_SEGUIMIENTO_INTERVALO_MS=10000
NUBEFACT_SEGUIMIENTO_ESPERAS_SEGUNDOS=15,30,60,120,300,600
NUBEFACT_SEGUIMIENTO_HORIZONTE_HORAS=48
NUBEFACT_SEGUIMIENTO_LOTE=20
# Consultas rápidas tras emitir (milisegundos entre intentos; 0 las desactiva).
NUBEFACT_CONSULTA_INMEDIATA_ESPERAS_MS=1000,2000,3000
DESCUENTO_MAXIMO_PORCENTAJE=0

# APIS PerÃº: token para consultar dniruc.apisperu.com (solo servidor)
APIS_PERU_TOKEN=
