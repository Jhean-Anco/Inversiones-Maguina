{
  "name": "inversiones-magina",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome lint apps/api/src apps/api/playwright.config.ts apps/web/src apps/web/vite.config.ts packages/database/src packages/database/drizzle.config.ts scripts .github/scripts",
    "test": "turbo run test --filter=@magina/api",
    "test:unit": "turbo run test:unit --filter=@magina/api",
    "test:integration": "turbo run test:integration --filter=@magina/api",
    "test:api": "turbo run test:api --filter=@magina/api",
    "test:security": "turbo run test:security --filter=@magina/api",
    "test:e2e": "playwright test --config apps/api/playwright.config.ts",
    "test:all:api": "turbo run test:all --filter=@magina/api",
    "test:all": "pnpm test:all:api && pnpm test:e2e",
    "test:coverage": "turbo run test:coverage --filter=@magina/api",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json pnpm-workspace.yaml turbo.json biome.jsonc \".github/workflows/*.yml\" \"compose*.yaml\"",
    "docs:api": "node scripts/documentar-api.mjs",
    "docs:data": "node scripts/documentar-datos.mjs",
    "docs:check": "pnpm docs:api && pnpm docs:data && node scripts/comprobar-documentacion.mjs",
    "check:frontend-architecture": "node scripts/check-frontend-architecture.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "argon2"
    ],
    "overrides": {
      "fastify": "5.12.8"
    }
  }
}
